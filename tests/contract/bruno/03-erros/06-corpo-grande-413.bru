meta {
  name: Corpo maior que 16 kb
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/companies/{{companyId}}/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "roomId": "{{roomId}}",
    "startsAt": "{{startsAt}}",
    "endsAt": "{{endsAt}}",
    "title": "{{bigTitle}}",
    "responsibleEmail": "ana.souza@acme.com.br"
  }
}

script:pre-request {
  const t = new Date();
  t.setUTCDate(t.getUTCDate() + 1);
  t.setUTCHours(15, 0, 0, 0);
  bru.setVar("startsAt", t.toISOString());
  bru.setVar("endsAt", new Date(t.getTime() + 60 * 60 * 1000).toISOString());
  bru.setVar("bigTitle", "x".repeat(17 * 1024));
}

assert {
  res.status: eq 413
  res.body.code: eq PAYLOAD_TOO_LARGE
}
