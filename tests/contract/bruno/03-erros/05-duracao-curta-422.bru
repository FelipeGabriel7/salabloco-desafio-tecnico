meta {
  name: Menos de 30 minutos
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/companies/{{companyId}}/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "roomId": "{{roomId}}",
    "startsAt": "{{startsAt}}",
    "endsAt": "{{endsAt}}",
    "title": "Curta",
    "responsibleEmail": "ana.souza@acme.com.br"
  }
}

script:pre-request {
  const t = new Date();
  t.setUTCDate(t.getUTCDate() + 1);
  t.setUTCHours(15, 0, 0, 0);
  bru.setVar("startsAt", t.toISOString());
  bru.setVar("endsAt", new Date(t.getTime() + 29 * 60 * 1000).toISOString());
}

assert {
  res.status: eq 422
  res.body.code: eq DURATION_TOO_SHORT
}
