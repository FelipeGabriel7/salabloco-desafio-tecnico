meta {
  name: 07 Duração menor que 30 min (422)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/companies/{{companyId}}/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "roomId": "{{roomId}}",
    "startsAt": "{{startsAt}}",
    "endsAt": "{{endsAt}}",
    "title": "Reunião curta demais",
    "responsibleEmail": "ana.souza@acme.com.br"
  }
}

script:pre-request {
  // 20 minutos, depois de amanhã, para não colidir com outras reservas.
  const t = new Date();
  t.setUTCDate(t.getUTCDate() + 2);
  t.setUTCHours(15, 0, 0, 0);
  bru.setVar("startsAt", t.toISOString());
  bru.setVar("endsAt", new Date(t.getTime() + 20 * 60 * 1000).toISOString());
}

assert {
  res.status: eq 422
}
