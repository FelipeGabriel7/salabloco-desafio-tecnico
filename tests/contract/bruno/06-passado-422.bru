meta {
  name: 06 Horário no passado (422)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/companies/{{companyId}}/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "roomId": "{{roomId}}",
    "startsAt": "2020-01-01T10:00:00.000Z",
    "endsAt": "2020-01-01T11:00:00.000Z",
    "title": "Reunião no passado",
    "responsibleEmail": "ana.souza@acme.com.br"
  }
}

assert {
  res.status: eq 422
}
