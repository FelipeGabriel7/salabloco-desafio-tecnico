meta {
  name: 02 Disponibilidade da sala
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/rooms/{{roomId}}/availability?date=2026-11-20
  body: none
  auth: bearer
}

params:query {
  date: 2026-11-20
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("horários ocupados não expõem título, e-mail nem empresa", function () {
    const busy = res.body.busy || [];
    busy.forEach(function (slot) {
      expect(slot).to.have.property("startsAt");
      expect(slot).to.have.property("endsAt");
      expect(slot).to.not.have.property("title");
      expect(slot).to.not.have.property("responsibleEmail");
      expect(slot).to.not.have.property("companyId");
    });
  });
}
