meta {
  name: Listar reservas da empresa
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/companies/{{companyId}}/bookings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("lista só reservas da própria empresa", function () {
    res.body.forEach(function (booking) {
      expect(booking.companyId).to.equal(bru.getEnvVar("companyId"));
    });
  });
}
