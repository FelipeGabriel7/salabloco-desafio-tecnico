meta {
  name: Disponibilidade da sala
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/rooms/{{roomId}}/availability?date=2030-01-15
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("mostra só início e fim", function () {
    res.body.busy.forEach(function (slot) {
      expect(slot).to.have.all.keys("startsAt", "endsAt");
    });
  });
}
