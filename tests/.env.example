# Configuração dos testes (Playwright). Copie para .env: npm run setup
# Valores de demonstração. Devem coincidir com apps/api/.env.example

# Onde a API e o front estão rodando
API_URL=http://localhost:3333
WEB_URL=http://localhost:5181

# Tokens de demonstração das empresas (os mesmos do .env da API)
ACME_TOKEN=demo-acme-7f3a9c2e
LUMEN_TOKEN=demo-lumen-4b8d1e6a
BRISA_TOKEN=demo-brisa-2c5f9a0d

# 1 = o Playwright sobe API e front sozinho; 0 = já estão rodando
START_SERVERS=1
