{
  "name": "salabloco",
  "private": true,
  "version": "0.1.0",
  "description": "Reserva de salas de reunião de um coworking",
  "workspaces": [
    "apps/*",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev:mock": "npm run dev -w apps/web",
    "test": "npm run test -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:api": "npm run test:api -w tests",
    "test:e2e": "npm run test:e2e -w tests"
  }
}
