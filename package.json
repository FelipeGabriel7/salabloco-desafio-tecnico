{
  "name": "salabloco",
  "private": true,
  "version": "0.1.0",
  "description": "Reserva de salas de reunião de um coworking",
  "workspaces": [
    "apps/*",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "test": "npm run test -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:api": "npm run test -w apps/api",
    "test:api:redis": "npm run test:redis -w apps/api",
    "test:e2e": "npm run test:e2e -w tests",
    "test:contract": "npm run test:contract -w tests",
    "test:performance": "npm run test:performance -w tests",
    "report": "npm run report -w tests",
    "validate": "node scripts/validate.mjs",
    "report:open": "npm run report:open -w tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
