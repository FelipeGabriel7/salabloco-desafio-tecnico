# Modo da API: "mock" (simulada no navegador, só para desenvolvimento) ou "http" (servidor real)
VITE_API_MODE=mock

# URL do servidor real, usada no modo http
VITE_API_URL=http://localhost:3333

# Tokens do MODO MOCK, no formato empresa:token separados por vírgula.
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript do navegador e fica PÚBLICA.
# Use só valores de demonstração e só no modo mock. Nunca um segredo real aqui.
VITE_MOCK_TOKENS=acme:demo-acme-7f3a9c2e,lumen:demo-lumen-4b8d1e6a,brisa:demo-brisa-2c5f9a0d
