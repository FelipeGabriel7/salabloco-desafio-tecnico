# Copie para .env (que o git ignora) e ajuste. NUNCA commite o .env.

NODE_ENV=development
PORT=3333

# Fuso do coworking (nome IANA). Outras regiões: America/Manaus, America/Fortaleza, America/Recife...
COWORKING_TIMEZONE=America/Sao_Paulo

# Arquivo de dados (só as reservas). Fica fora do git.
DB_PATH=./data/db.json

# Tokens das empresas. Valores de DEMONSTRAÇÃO.
# Em qualquer ambiente real, gere valores novos e longos (por exemplo: openssl rand -hex 32).
# Em produção o servidor se recusa a subir com estes valores de exemplo.
COMPANY_ACME_TOKEN=demo-acme-7f3a9c2e
COMPANY_LUMEN_TOKEN=demo-lumen-4b8d1e6a
COMPANY_BRISA_TOKEN=demo-brisa-2c5f9a0d

# Limite de requisições (ADR 0012)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
AUTH_FAIL_MAX=10
AUTH_FAIL_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=60
