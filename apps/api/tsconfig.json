{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src",
    "api",
    "tests",
    "vitest.config.ts"
  ]
}
